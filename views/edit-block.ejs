<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TimeBlock - Edit Block</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/nav') %>

    <main>
        <h1>Edit Block</h1>

        <form class="block-form edit-form" method="POST" action="/tracker/<%= block._id %>/edit">
            <label>
                Time
                <input type="text" name="time" value="<%= block.time %>" required>
            </label>
            <label>
                Activity
                <input type="text" name="activity" value="<%= block.activity %>" required>
            </label>
            <label>
                Project (optional)
                <input type="text" name="project" value="<%= block.project %>">
            </label>
            <button type="submit">Save</button>
            <a href="/tracker">Cancel</a>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
