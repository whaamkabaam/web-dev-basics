<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TimeBlock - Tracker</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/main.js" defer></script>
</head>
<body>
    <%- include('partials/nav') %>

    <main>
        <h1>Daily Tracker</h1>

        <form class="block-form add-form" method="POST" action="/tracker">
            <label>
                Time
                <input type="time" name="time" required>
            </label>
            <label>
                Activity
                <input type="text" name="activity" required>
            </label>
            <label>
                Project (optional)
                <input type="text" name="project">
            </label>
            <button type="submit">Add block</button>
        </form>

        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Activity</th>
                    <th>Project</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% blocks.forEach(function(block) { %>
                    <tr>
                        <td><%= block.time %></td>
                        <td><%= block.activity %></td>
                        <td><%= block.project %></td>
                        <td>
                            <a class="edit-link" href="/tracker/<%= block._id %>/edit">Edit</a>
                            <button class="delete-btn" data-id="<%= block._id %>">Delete</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
